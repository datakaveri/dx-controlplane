{
  "version": "1.0",
  "zookeepers": [
    "<ZOOKEEPER_HOSTNAME_OR_SERVICE_NAME>"
  ],
  "clusterId": "<CLUSTER_ID_STRING>",

  "postgresOptions": {
    "databaseIP": "<POSTGRES_HOST>",
    "databasePort": 5432,
    "databaseName": "<POSTGRES_DATABASE_NAME>",
    "databaseSchema": "<POSTGRES_SCHEMA_NAME>",
    "databaseUserName": "<POSTGRES_USERNAME>",
    "databasePassword": "<POSTGRES_PASSWORD>",
    "poolSize": 25
  },

  "commonOptions": {
    "controlPlaneDomain": "<CONTROL_PLANE_DOMAIN>",
    "dxApiBasePath": "<DX_API_BASE_PATH>",
    "cosDomain": "<COS_DOMAIN>",
    "dataPlaneUrl": "<DATA_PLANE_URL>",
    "tokenExpirationMinutes": 60,
    "clientId": "<OAUTH_CLIENT_ID>",
    "clientSecret": "<OAUTH_CLIENT_SECRET>",
    "supportEmail": "<SUPPORT_EMAIL_ADDRESS>",
    "baseUrl": "<BASE_APPLICATION_URL>",
    "apdURL": "<APD_SERVICE_URL>",
    "tenantPrefix": "<TENANT_PREFIX>",
    "kycRequired": false,
    "jwtIgnoreExpiry": true,
    "routingKey": "##",
    "cosAdminUserId": "<COS_ADMIN_USER_ID>",
    "initialCreditBalance": 1000,
    "verifiedBy": "<VERIFIED_BY_ORGANIZATION_NAME>",
    "corsAllowedOrigin": [
      "*",
      "<FRONTEND_URL_1>",
      "<FRONTEND_URL_2>"
    ],
    "publisherPanelUrl": "<PUBLISHER_PANEL_URL>",
    "docIndex": "<ELASTIC_DOC_INDEX>",
    "vocContext": "<VOCABULARY_CONTEXT_URL>",
    "defaultExpiryDays": 12
  },

  "emailOptions": {
    "emailSender": "<NO_REPLY_EMAIL_ADDRESS>",
    "platformName": "<PLATFORM_DISPLAY_NAME>",
    "cosAdminEmailId": "<COS_ADMIN_EMAIL_ADDRESS>",
    "TGDxUrl": "<TGDX_BASE_URL>"
  },

  "emailConfig": {
    "emailSender": "<NO_REPLY_EMAIL_ADDRESS>",
    "emailSupport": [
      "<SUPPORT_EMAIL_ADDRESS>"
    ],
    "publisherPanelUrl": "<PUBLISHER_PANEL_URL>",
    "emailNotification": {
      "emailQueue": "<EMAIL_QUEUE_NAME>",
      "emailExchange": "<EMAIL_EXCHANGE_NAME>",
      "emailRoutingKey": "##"
    },
    "senderName": "<EMAIL_SENDER_NAME>"
  },

  "keycloakOptions": {
    "keycloakRealm": "<KEYCLOAK_REALM_NAME>",
    "keycloakUrl": "<KEYCLOAK_BASE_URL>",
    "keycloakAdminClientId": "<KEYCLOAK_ADMIN_CLIENT_ID>",
    "keycloakAdminClientSecret": "<KEYCLOAK_ADMIN_CLIENT_SECRET>",
    "keycloakAdminPoolSize": "25",
    "adminUsername": "<KEYCLOAK_ADMIN_USERNAME>",
    "adminPassword": "<KEYCLOAK_ADMIN_PASSWORD>",

    "authPorvider": [
      {
        "certUrl": "<JWT_CERT_URL>",
        "iss": "<JWT_ISSUER_URL>"
      },
      {
        "name": "<SOCIAL_AUTH_PROVIDER_NAME>",
        "clientId": "<SOCIAL_CLIENT_ID>",
        "clientSecret": "<SOCIAL_CLIENT_SECRET>",
        "redirectUri": "<SOCIAL_REDIRECT_URI>"
      }
    ],

    "issuers": {
      "jwtIgnoreExpiry": true,
      "leeway": 30,
      "jwksRefreshIntervalMs": 21600000,
      "<ISSUER_DOMAIN>": {
        "type": "internal",
        "audience": []
      }
    }
  },

  "KYCOptions": {
    "digilockerTokenUrl": "<DIGILOCKER_TOKEN_URL>",
    "digilockerAadhaarUrl": "<DIGILOCKER_AADHAAR_URL>",
    "clientId": "<KYC_CLIENT_ID>",
    "clientSecret": "<KYC_CLIENT_SECRET>",
    "redirectUri": "<KYC_REDIRECT_URI>"
  },

  "jwtKeystoreOptions": {
    "keystorePath": "<KEYSTORE_FILE_PATH>",
    "keystorePassword": "<KEYSTORE_PASSWORD>"
  },

  "databrokerOptions": {
    "dataBrokerIP": "<RABBITMQ_HOST>",
    "dataBrokerPort": 24568,
    "prodVhost": "<PROD_VHOST_NAME>",
    "internalVhost": "<INTERNAL_VHOST_NAME>",
    "externalVhost": "<EXTERNAL_VHOST_NAME>",
    "dataBrokerUserName": "<RABBITMQ_USERNAME>",
    "dataBrokerPassword": "<RABBITMQ_PASSWORD>",
    "dataBrokerManagementPort": 28042,
    "connectionTimeout": 6000,
    "requestedHeartbeat": 60,
    "handshakeTimeout": 6000,
    "requestedChannelMax": 5,
    "networkRecoveryInterval": 500,
    "automaticRecoveryEnabled": true,
    "brokerAmqpIp": "<AMQP_HOST>",
    "brokerAmqpPort": 24567,
    "publishExchange": "<AMQP_EXCHANGE_NAME>"
  },

  "auditOptions": {
    "auditingExchange": "<AUDIT_EXCHANGE_NAME>",
    "auditingRoutingKey": "##",
    "auditingQueue": "<AUDIT_QUEUE_NAME>",
    "isRemoteAudit": true
  },

  "modules": [
    {
      "id": "org.cdpg.dx.database.postgres.verticle.PostgresVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false,
      "required": [
        "postgresOptions",
        "commonOptions"
      ]
    },
    {
      "id": "org.cdpg.dx.email.verticle.EmailVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": true,
      "threadPoolName": "emailVerticleThreadPool",
      "threadPoolSize": 10,
      "required": [
        "commonOptions",
        "databrokerOptions",
        "keycloakOptions",
        "emailOptions",
        "emailConfig"
      ],
      "emailHostName": "<SMTP_HOST>",
      "emailPort": 587,
      "emailUserName": "<SMTP_USERNAME>",
      "emailPassword": "<SMTP_PASSWORD>",
      "notifyByEmail": true
    },
    {
      "id": "org.cdpg.dx.database.elastic.ElasticsearchVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "tenantPrefix": "<ELASTIC_TENANT_PREFIX>",
      "databaseIP": "<ELASTICSEARCH_HOST>",
      "databasePort": 9200,
      "databaseUser": "<ELASTIC_USERNAME>",
      "databasePassword": "<ELASTIC_PASSWORD>"
    },
    {
      "id": "org.cdpg.dx.aaa.delegation.DelegationVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1
    }
  ]
}
