{
  "version": "1.0",
  "zookeepers": [
    "localhost:2181"
  ],
  "clusterId": "iudx-v2-control-panel-cluster",
  "postgresOptions": {
    "databaseIP": "127.0.0.1",
    "databasePort": 5433,
    "databaseName": "iudx_db",
    "databaseSchema": "public",
    "databaseUserName": "iudx_user",
    "databasePassword": "iudx_password",
    "poolSize": 25
  },
  "commonOptions": {
    "controlPlaneDomain": "controlplane.dev.iudx.io",
    "dxApiBasePath": "/dx",
    "cosDomain": "cos.dev.iudx.io",
    "dataPlaneUrl": "https://dataplane.dev.iudx.io",
    "tokenExpirationMinutes": 60,
    "clientId": "dummy-client-id",
    "clientSecret": "dummy-client-secret",
    "supportEmail": "support@datakaveri.org",
    "baseUrl": "https://controlplane.dev.iudx.io",
    "apdURL": "https://apd.dev.iudx.io",
    "tenantPrefix": "iudx-v2",
    "kycRequired": false,
    "jwtIgnoreExpiry": true,
    "routingKey": "##",
    "cosAdminUserId": "cos-admin",
    "initialCreditBalance": 1000,
    "uploadedBy": "",
    "corsAllowedOrigin": [
      "*",
      "http://localhost:4007",
      "http://localhost:4002",
      "http://localhost:4001",
      "https://staging.catalogue.tgdex.iudx.io",
      "https://controlplane.tgdex.iudx.io",
      "https://catalogue.tgdex.iudx.io",
      "https://catalogue.forest-stack.test.iudx.io",
      "https://catalogue.forest-stack.iudx.io"
    ],
    "publisherPanelUrl": "https://publisher.dev.iudx.io",
    "docIndex": "iudx-docs",
    "docUserIndex": "doc_user_index",
    "vocContext": "https://voc.dev.iudx.io",
    "defaultExpiryDays": 12,
    "appIdRevokeExchange": "revoked-appid"
  },
  "emailOptions": {
    "emailSender": "no-reply@iudx.io",
    "platformName": "Forest Stack Rajasthan",
    "platformShortName": "<short-form-of-exchange-name>",
    "cosAdminEmailId": "admin@iudx.io",
    "TGDxUrl": "https://catalogue.v2.dev.iudx.io"
  },
  "emailConfig": {
    "emailSender": "no-reply@iudx.io",
    "emailSupport": [
      "support@iudx.io"
    ],
    "publisherPanelUrl": "https://publisher.dev.iudx.io",
    "emailNotification": {
      "emailQueue": "email-queue",
      "emailExchange": "Email",
      "emailRoutingKey": "##"
    },
    "senderName": "IUDX v2"
  },
  "keycloakOptions": {
    "keycloakRealm": "iudx",
    "keycloakUrl": "https://keycloak.dev.iudx.io",
    "keycloakAdminClientId": "admin-cli",
    "keycloakAdminClientSecret": "admin-secret",
    "keycloakAdminPoolSize": "25",
    "adminUsername": "kc-admin",
    "authPorvider": [
      {
        "certUrl": "https://auth.dev.iudx.io/certs",
        "iss": "https://auth.dev.iudx.io"
      },
      {
        "name": "facebook",
        "clientId": "fb-client-id",
        "clientSecret": "fb-client-secret",
        "redirectUri": "https://controlplane.dev.iudx.io/callback"
      }
    ],
    "adminPassword": "kc-admin-password",
    "issuers": {
      "jwtIgnoreExpiry": true,
      "leeway": 30,
      "jwksRefreshIntervalMs": 21600000,
      "v2.dev.controlplane.iudx.io": {
        "type": "internal",
        "audience": []
      },
      "https://v2.dev.keycloak.iudx.io/auth/realms/iudx-v2": {
        "type": "remote",
        "jwksUrl": "https://auth.remote.iudx.io/jwks",
        "audience": []
      }
    }
  },
  "KYCOptions": {
    "digilockerTokenUrl": "https://digilocker.dev/token",
    "digilockerAadhaarUrl": "https://digilocker.dev/aadhaar",
    "clientId": "kyc-client-id",
    "clientSecret": "kyc-client-secret",
    "redirectUri": "https://controlplane.dev.iudx.io/kyc"
  },
  "jwtKeystoreOptions": {
    "keystorePath": "/etc/iudx/jwt-keystore.jks",
    "keystorePassword": "keystore-password"
  },
  "databrokerOptions": {
    "dataBrokerIP": "127.0.0.1",
    "dataBrokerPort": 24568,
    "prodVhost": "/prod",
    "internalVhost": "/internal",
    "externalVhost": "/external",
    "dataBrokerUserName": "admin",
    "dataBrokerPassword": "admin",
    "dataBrokerManagementPort": 28042,
    "connectionTimeout": 6000,
    "requestedHeartbeat": 60,
    "handshakeTimeout": 6000,
    "requestedChannelMax": 5,
    "networkRecoveryInterval": 500,
    "automaticRecoveryEnabled": "true",
    "brokerAmqpIp": "127.0.0.1",
    "brokerAmqpPort": 24567,
    "publishExchange": "rpc-adapter-requests"
  },
  "auditOptions": {
    "auditingExchange": "auditing",
    "auditingRoutingKey": "##",
    "auditingQueue": "dummy-auditing",
    "isRemoteAudit": true
  },
  "modules": [
    {
      "id": "org.cdpg.dx.database.postgres.verticle.PostgresVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false,
      "required": [
        "postgresOptions",
        "commonOptions"
      ]
    },
    {
      "id": "org.cdpg.dx.email.verticle.EmailVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": true,
      "threadPoolName": "emailVerticleThreadPool",
      "threadPoolSize": 10,
      "required": [
        "commonOptions",
        "databrokerOptions",
        "keycloakOptions",
        "emailOptions",
        "emailConfig"
      ],
      "emailHostName": "email-smtp.ap-south-1.amazonaws.com",
      "emailPort": 587,
      "emailUserName": "smtp-user",
      "emailPassword": "smtp-password",
      "notifyByEmail": true
    },
    {
      "id": "org.cdpg.dx.catalogueService.CatalogueVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "dxCatalogueBasePath": "/catalogue",
      "catServerHost": "catalogue.dev.iudx.io",
      "catServerPort": 443,
      "required": [
        "commonOptions"
      ]
    },
    {
      "id": "org.cdpg.dx.databroker.DataBrokerVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "required": [
        "databrokerOptions",
        "auditOptions",
        "emailNotification"
      ]
    },
    {
      "id": "org.cdpg.dx.database.elastic.ElasticsearchVerticle",
      "isWorkerVerticle": false,
      "verticleInstances": 1,
      "tenantPrefix": "iudx-v2",
      "databaseIP": "127.0.0.1",
      "databasePort": 9200,
      "databaseUser": "elastic",
      "databasePassword": "elastic-password"
    },
    {
      "id": "org.cdpg.dx.aaa.apiserver.ApiServerVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false,
      "httpPort": 8080,
      "required": [
        "postgresOptions",
        "commonOptions",
        "keycloakOptions",
        "KYCOptions",
        "emailOptions",
        "emailConfig",
        "jwtKeystoreOptions",
        "databrokerOptions",
        "auditOptions"
      ],
      "urnPrefix": "dx:controlPlane:",
      "serverTimeoutMs": 30000,
      "corsRegexString": "^https://.+\\.iudx\\.org\\.in$"
    },
    {
      "id": "org.cdpg.dx.acl.apiserver.ApdApiServerVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false,
      "httpPort": 8444,
      "required": [
        "postgresOptions",
        "commonOptions",
        "keycloakOptions",
        "KYCOptions",
        "emailOptions",
        "emailConfig",
        "jwtKeystoreOptions",
        "databrokerOptions",
        "auditOptions"
      ],
      "serverTimeoutMs": 30000,
      "corsRegexString": "^https://.+\\.iudx\\.org\\.in$",
      "urnPrefix": "dx:aclApd:"
    },
    {
      "id": "org.cdpg.dx.scheduler.verticle.SchedulerVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": true,
      "schedulerTimeIntervalInMinutes": 30,
      "threadPoolSize": 3
    },
    {
      "id": "org.cdpg.dx.aaa.delegation.DelegationVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false
    },
    {
      "id": "org.cdpg.dx.aaa.grpc.GrpcServerVerticle",
      "verticleInstances": 1,
      "isWorkerVerticle": false,
      "grpcPort": 9090,
      "required": ["postgresOptions", "commonOptions", "keycloakOptions"]
    }
  ]
}
