{
  "realm": "iudx",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      { "name": "cos_admin", "description": "COS Administrator" },
      { "name": "org_admin", "description": "Organization Administrator" },
      { "name": "provider", "description": "Data Provider" },
      { "name": "consumer", "description": "Data Consumer" },
      { "name": "delegate", "description": "Delegate" },
      { "name": "compute", "description": "Compute User" }
    ]
  },
  "clients": [
    {
      "clientId": "admin-cli",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "admin-secret",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "postman-client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "angular-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4001/*",
        "http://localhost:4002/*",
        "http://localhost:4003/*"
      ],
      "webOrigins": [
        "http://localhost:4001",
        "http://localhost:4002",
        "http://localhost:4003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-admin-cli",
      "enabled": true,
      "serviceAccountClientId": "admin-cli",
      "realmRoles": ["default-roles-iudx"],
